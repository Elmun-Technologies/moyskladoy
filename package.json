{
  "name": "moyskladoy-bot-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Jamshid (@ogriqqa_yechim) - Moy Sklad: Telegram bot, sayt shakli, sotuvga topshirish va administrator paneli",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:bot": "npm run dev -w apps/bot",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:admin": "npm run dev -w apps/admin",
    "db:generate": "npm run db:generate -w packages/db",
    "db:push": "npm run db:push -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=22"
  }
}
