# ============================================================================
# .env.example - HAQIQIY QIYMATLARNI GIT'GA YOZMA! Bu fayl faqat shablon.
# Haqiqiy qiymatlar serverdagi .env fayliga kiritiladi (git ignore qilingan).
# ============================================================================

# --- Umumiy ---------------------------------------------------------------
# production | demo   (demo: in-memory DB, soxta Telegram adapter, hech kimga real xabar ketmaydi)
NODE_ENV=development
# "true" bo'lsa - demo rejimi majburlanadi (tasodifan production rejimiga blok)
DEMO_MODE=true

# --- Bazalar ---------------------------------------------------------------
# PostgreSQL (bo'sh bo'lsa - demo rejimi, in-memory)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/moyskladoy?schema=public
# Redis (bo'sh bo'lsa - in-process navbatlar)
REDIS_URL=redis://localhost:6380/0

# --- Telegram bot ----------------------------------------------------------
# @BotFather'dan olinadi. Bu yerga HAQIQIY tokenni QO'YMA - server .env'ga.
TELEGRAM_BOT_TOKEN=
# Bot username (havola uchun), @ belgisisiz: e.g. ogriqqa_yechim_bot
BOT_USERNAME=
# Webhook maxfiy kaliti (nginx/server'da utilizanadi)
TELEGRAM_WEBHOOK_SECRET=
# Lokal testda polling, serverda webhook (avtomatik: PUBLIC_URL bo'lsa webhook)
BOT_MODE=polling
# Admin bildirishnomalari yuboriladigan yopiq sotuv guruhi chat id (manfiy son)
SALES_GROUP_CHAT_ID=
# Sotuv xodimlarining Telegram id'lari (vergul bilan): 123456789,987654321
SALES_STAFF_TELEGRAM_IDS=

# --- API (Fastify) ---------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Sayt shakli RF route (demo sahifa shu API'dan Blitz)
PUBLIC_URL=http://localhost:4000
# CORS uchun ruxsat etilgan manbalar (vergul bilan)
CORS_ORIGINS=http://localhost:3000
# Form spam himoyasi: IP'dan 10 daqiqada maks. so'rovlar soni
FORM_RATE_LIMIT_MAX=5
# Formani to'ldirishning minimal vaqti (ms) - botlar uchun
FORM_MIN_FILL_MS=1500
# IP hash uchun salt (maxfiy)
IP_HASH_SALT=change-me-to-a-long-random-string
# Bog'lash tokenining amal qilish muddati (soat)
LINK_TOKEN_TTL_HOURS=24

# --- Admin panel -----------------------------------------------------------
ADMIN_PORT=3000
# Panelning server'dagi API manzili (server-side fetch uchun)
API_INTERNAL_URL=http://api:4000
# Browser'dan API'ga (client-side fetch uchun)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sessiya maxfiy kaliti (kamida 32 ta tasodifiy belgi)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Boshlang'ich admin (faqat seed'da ishlatiladi)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# --- Worker (eslatmalar) ---------------------------------------------------
WORKER_ENABLED=true
# Eslatma tekshiruvi davri (ms)
REMINDER_TICK_MS=60000
# Marketing xabarlari oynasi (Toshkent vaqti) - 09:00-20:00
MARKETING_WINDOW_START=09:00
MARKETING_WINDOW_END=20:00
# Bir classifica kuniga maks. marketing xabari
MARKETING_MAX_PER_DAY=1
# Yuborish urinishlari orasidagi interval (ms)
OUTBOX_RETRY_BACKOFF_MS=900000
OUTBOX_MAX_ATTEMPTS=5

# --- SMS / Eskiz -----------------------------------------------------------
# Ixtiyoriy. Bo'sh bo'lsa SMS yuborish o'chiriladi; queued yozuvlar saqlanib qoladi.
SMS_USER=
SMS_PASSWORD=
SMS_FROM=4546
# Faqat taxmin uchun, Eskiz hisobingizning rasmiy kotirovkasi emas.
SMS_PRICE_PER_PART_UZS=95
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BACKOFF_MS=900000

# --- Kontent ---------------------------------------------------------------
# Sinov dersi havolasi (admin paneldan ham o'zgartiriladi)
LESSON_LINK=
# Xizmat bo'yicha narx belgilash tartibi matni (admin paneldan o'zgartiriladi)
SERVICE_PRICING_TEXT=
# Ma'lumotlarni saqlash muddati (kun) - 0 = cheksiz
RETENTION_DAYS=0

# --- Media ----------------------------------------------------------------
# Maksimal yuklash hajmi (bayt), standartin 50MB
MEDIA_MAX_BYTES=52428800
# ffmpeg path (video note format tekshiruvi uchun, bo'lsa)
FFMPEG_PATH=ffmpeg
